# /etc/zabbix-portal/portal.env  (owner root, mode 640, group zbxportal)

# Zabbix frontend or API URL: the ONLY required setting.
# "/api_jsonrpc.php" is added automatically when missing.
ZABBIX_URL=http://localhost:8080/zabbix/api_jsonrpc.php

# Zabbix over HTTPS with a company CA or self-signed certificate:
# copy the CA (PEM) here and point to it. Keep ZABBIX_INSECURE_SSL=false.
#ZABBIX_CA_FILE=/etc/zabbix-portal/zabbix-ca.pem
ZABBIX_INSECURE_SSL=false

# Listen only on localhost; Apache is the only way in from outside
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081

# The portal is served over HTTPS (through Apache)
PORTAL_SECURE_COOKIE=true

# No cross-origin access in production (only the Vite dev server needs it)
PORTAL_CORS_ORIGINS=

# Only members of these Zabbix user groups may sign in (comma-separated).
# Leave commented out to allow any Zabbix user with API access.
#PORTAL_ALLOWED_GROUPS=Portal users

# Sign out after this much inactivity
PORTAL_SESSION_TIMEOUT=30m

# Block an IP for 15 minutes after 10 failed sign-ins
PORTAL_LOGIN_MAX_FAILURES=10
PORTAL_LOGIN_WINDOW=15m

# Host tag that names the application, if your Zabbix uses one. The application search
# then matches host group, host name and this tag.
#PORTAL_APP_TAG=application

# --- Look of this installation (no rebuild needed) ---
# Name in the header and browser tab
#PORTAL_TITLE=Zabbix Self-Service Portal
# Logo: SVG, PNG or JPG up to 1 MB, kept in /etc/zabbix-portal (the service cannot read /home)
#PORTAL_LOGO_FILE=/etc/zabbix-portal/logo.svg
# Brand colours as hex: primary = buttons and sign-in panel, accent = links, selection, focus
#PORTAL_PRIMARY_COLOR=#16294A
#PORTAL_ACCENT_COLOR=#0B7A85
